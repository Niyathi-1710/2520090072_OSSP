#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define SIZE (10 * 1024 * 1024)   // 10 MB

char data[SIZE];

int main() {
    pid_t pid;

    // Fill the array
    for (int i = 0; i < SIZE; i++)
        data[i] = 'A';

    printf("Before fork(): Process memory contains 10 MB of data.\n");

    pid = fork();

    if (pid < 0) {
        perror("fork failed");
        return 1;
    }

    if (pid == 0) {
        // Child process
        printf("Child: Memory is initially shared using Copy-on-Write.\n");

        // Modify the data
        for (int i = 0; i < SIZE; i++)
            data[i] = 'B';

        printf("Child: Data modified. Private memory pages are now created.\n");

        printf("Child data[0] = %c\n", data[0]);

        exit(0);
    }
    else {
        // Parent process
        printf("Parent: Data remains unchanged.\n");
        printf("Parent data[0] = %c\n", data[0]);

        wait(NULL);

        printf("Parent: Child process completed.\n");
    }

    return 0;
}
