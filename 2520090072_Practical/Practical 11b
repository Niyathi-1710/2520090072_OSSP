#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

/* Two shared resources */
pthread_mutex_t resource1;
pthread_mutex_t resource2;

/* Thread 1 */
void *thread1_function(void *arg)
{
    printf("Thread 1: Trying to acquire Resource 1...\n");
    pthread_mutex_lock(&resource1);

    printf("Thread 1: Acquired Resource 1.\n");

    sleep(1);

    printf("Thread 1: Trying to acquire Resource 2...\n");
    pthread_mutex_lock(&resource2);

    printf("Thread 1: Acquired Resource 2.\n");

    printf("Thread 1: Using both resources...\n");

    sleep(1);

    pthread_mutex_unlock(&resource2);
    pthread_mutex_unlock(&resource1);

    printf("Thread 1: Released both resources.\n");

    return NULL;
}

/* Thread 2 */
void *thread2_function(void *arg)
{
    /*
     * Resource ordering:
     * Always acquire Resource 1 first,
     * then Resource 2.
     */

    printf("Thread 2: Trying to acquire Resource 1...\n");
    pthread_mutex_lock(&resource1);

    printf("Thread 2: Acquired Resource 1.\n");

    sleep(1);

    printf("Thread 2: Trying to acquire Resource 2...\n");
    pthread_mutex_lock(&resource2);

    printf("Thread 2: Acquired Resource 2.\n");

    printf("Thread 2: Using both resources...\n");

    sleep(1);

    pthread_mutex_unlock(&resource2);
    pthread_mutex_unlock(&resource1);

    printf("Thread 2: Released both resources.\n");

    return NULL;
}

int main()
{
    pthread_t thread1, thread2;

    /* Initialize mutexes */
    pthread_mutex_init(&resource1, NULL);
    pthread_mutex_init(&resource2, NULL);

    printf("============================================\n");
    printf("   DEADLOCK PREVENTION USING RESOURCE ORDER\n");
    printf("============================================\n\n");

    /* Create threads */
    pthread_create(&thread1, NULL,
                   thread1_function, NULL);

    pthread_create(&thread2, NULL,
                   thread2_function, NULL);

    /* Wait for threads */
    pthread_join(thread1, NULL);
    pthread_join(thread2, NULL);

    /* Destroy mutexes */
    pthread_mutex_destroy(&resource1);
    pthread_mutex_destroy(&resource2);

    printf("\n============================================\n");
    printf("No deadlock occurred.\n");
    printf("Resource ordering successfully prevented\n");
    printf("the circular wait condition.\n");
    printf("============================================\n");

    return 0;
}
