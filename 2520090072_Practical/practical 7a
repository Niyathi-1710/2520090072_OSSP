#include <stdio.h>
#include <stdlib.h>

int main() {
    int i;

    // 1. malloc() - allocate memory for 5 integers
    int *a = (int *)malloc(5 * sizeof(int));

    if (a == NULL) {
        printf("malloc failed\n");
        return 1;
    }

    for (i = 0; i < 5; i++)
        a[i] = i + 1;

    printf("Memory allocated using malloc:\n");
    for (i = 0; i < 5; i++)
        printf("%d ", a[i]);
    printf("\n");

    // 2. calloc() - allocate memory for 5 integers
    int *b = (int *)calloc(5, sizeof(int));

    if (b == NULL) {
        printf("calloc failed\n");
        free(a);
        return 1;
    }

    printf("Memory allocated using calloc:\n");
    for (i = 0; i < 5; i++)
        printf("%d ", b[i]);
    printf("\n");

    // 3. realloc() - increase memory of a from 5 to 10 integers
    a = (int *)realloc(a, 10 * sizeof(int));

    if (a == NULL) {
        printf("realloc failed\n");
        free(b);
        return 1;
    }

    for (i = 5; i < 10; i++)
        a[i] = i + 1;

    printf("After realloc:\n");
    for (i = 0; i < 10; i++)
        printf("%d ", a[i]);
    printf("\n");

    // 4. free() - release allocated memory
    free(a);
    free(b);

    printf("Memory freed successfully.\n");

    return 0;
}
