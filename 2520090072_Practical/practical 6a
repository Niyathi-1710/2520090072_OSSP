#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <string.h>

int main()
{
    int fd;
    char msg[100];

    mkfifo("myfifo", 0666);

    fd = open("myfifo", O_RDONLY);

    read(fd, msg, sizeof(msg));

    printf("Message from Client: %s\n", msg);

    close(fd);

    fd = open("myfifo", O_WRONLY);

    char reply[] = "Message Received Successfully";
    write(fd, reply, strlen(reply)+1);

    close(fd);

    return 0;
}
