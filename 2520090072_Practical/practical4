#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    int i;
    pid_t pid;

    for(i = 1; i <= 3; i++)
    {
        pid = fork();

        if(pid == 0)
        {
            printf("Child %d\n", i);
            printf("PID  : %d\n", getpid());
            printf("PPID : %d\n", getppid());

            sleep(2);

            printf("Child %d completed.\n\n", i);
            exit(0);
        }
    }

    // Parent waits for all children
    for(i = 1; i <= 3; i++)
    {
        wait(NULL);
    }

    printf("All child processes completed.\n");

    return 0;
}
