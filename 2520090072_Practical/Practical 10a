#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

#define NUM_THREADS 4
#define INCREMENTS 100000

/* Shared variable */
int counter = 0;

/* Thread function */
void *increment_counter(void *arg)
{
    for (int i = 0; i < INCREMENTS; i++)
    {
        counter++;
    }

    return NULL;
}

int main()
{
    pthread_t threads[NUM_THREADS];

    printf("Multithreaded Counter Program\n");
    printf("Number of threads: %d\n", NUM_THREADS);
    printf("Increments per thread: %d\n\n", INCREMENTS);

    /* Create threads */
    for (int i = 0; i < NUM_THREADS; i++)
    {
        if (pthread_create(&threads[i], NULL,
                           increment_counter, NULL) != 0)
        {
            perror("Error creating thread");
            return 1;
        }
    }

    /* Wait for all threads */
    for (int i = 0; i < NUM_THREADS; i++)
    {
        pthread_join(threads[i], NULL);
    }

    /* Display result */
    printf("Expected counter value: %d\n",
           NUM_THREADS * INCREMENTS);

    printf("Actual counter value:   %d\n", counter);

    if (counter != NUM_THREADS * INCREMENTS)
    {
        printf("\nRace condition detected!\n");
    }
    else
    {
        printf("\nNo race condition observed this time.\n");
    }

    return 0;
}
