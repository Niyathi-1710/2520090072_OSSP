#include <stdio.h>
#include <stdlib.h>
#include <sys/stat.h>
#include <unistd.h>
#include <fcntl.h>

void show_inode(const char *filename)
{
    struct stat st;

    if (stat(filename, &st) == -1)
    {
        perror("stat");
        return;
    }

    printf("\nFile: %s\n", filename);
    printf("Inode Number : %lu\n", (unsigned long)st.st_ino);
    printf("File Size    : %ld bytes\n", (long)st.st_size);
    printf("Hard Links   : %lu\n", (unsigned long)st.st_nlink);
    printf("Permissions  : %o\n", st.st_mode & 0777);
}

int main()
{
    int fd;

    /* Create the original file */
    fd = open("original.txt", O_CREAT | O_WRONLY, 0644);

    if (fd == -1)
    {
        perror("Error creating file");
        return 1;
    }

    write(fd, "Hello! This is an inode experiment.\n", 35);
    close(fd);

    printf("=== ORIGINAL FILE ===\n");
    show_inode("original.txt");

    /* Create a hard link */
    if (link("original.txt", "hardlink.txt") == -1)
    {
        perror("Error creating hard link");
        return 1;
    }

    /* Create a symbolic link */
    if (symlink("original.txt", "symlink.txt") == -1)
    {
        perror("Error creating symbolic link");
        return 1;
    }

    printf("\n=== AFTER CREATING LINKS ===\n");

    printf("\nOriginal file:");
    show_inode("original.txt");

    printf("\nHard link:");
    show_inode("hardlink.txt");

    printf("\nSymbolic link:");
    show_inode("symlink.txt");

    printf("\n=== INODE COMPARISON ===\n");

    struct stat original, hard, symbolic;

    stat("original.txt", &original);
    stat("hardlink.txt", &hard);

    /* lstat() is used for symbolic links */
    lstat("symlink.txt", &symbolic);

    printf("Original inode : %lu\n",
           (unsigned long)original.st_ino);

    printf("Hard link inode: %lu\n",
           (unsigned long)hard.st_ino);

    printf("Symbolic link inode: %lu\n",
           (unsigned long)symbolic.st_ino);

    if (original.st_ino == hard.st_ino)
        printf("\nHard link and original have the SAME inode.\n");

    if (original.st_ino != symbolic.st_ino)
        printf("Symbolic link has a DIFFERENT inode.\n");

    printf("\n=== COMMANDS TO INVESTIGATE ===\n");
    printf("Run these commands in the terminal:\n\n");

    printf("ls -i original.txt hardlink.txt symlink.txt\n");
    printf("stat original.txt\n");
    printf("stat hardlink.txt\n");
    printf("stat symlink.txt\n");
    printf("find . -inum %lu\n",
           (unsigned long)original.st_ino);

    return 0;
}
