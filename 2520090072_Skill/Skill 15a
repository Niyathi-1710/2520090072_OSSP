#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_INPUT 200

int main()
{
    char input[MAX_INPUT];
    char command[100];
    char arg1[100];
    char arg2[100];
    char filename[100];

    int output_file;
    int original_stdout;
    int original_stderr;

    pid_t pid;
    int status;

    printf("Enter command with combined redirection:\n");
    printf("Example: ls existing.txt missing.txt > combined.txt 2>&1\n\n");

    printf("Input: ");
    fgets(input, sizeof(input), stdin);

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /*
     * Parse:
     *
     * command arg1 arg2 > filename 2>&1
     *
     * Example:
     * ls existing.txt missing.txt > combined.txt 2>&1
     */
    if (sscanf(input, "%s %s %s > %s 2>&1",
               command, arg1, arg2, filename) != 4)
    {
        printf("\nInvalid input format.\n");
        printf("Use:\n");
        printf("command arg1 arg2 > filename 2>&1\n");
        return 1;
    }

    printf("\nCommand      : %s\n", command);
    printf("Argument 1   : %s\n", arg1);
    printf("Argument 2   : %s\n", arg2);
    printf("Output file  : %s\n", filename);

    /*
     * Open output file.
     *
     * O_WRONLY -> write only
     * O_CREAT  -> create if it doesn't exist
     * O_TRUNC  -> remove old contents
     */
    output_file = open(filename,
                       O_WRONLY | O_CREAT | O_TRUNC,
                       0644);

    if (output_file == -1)
    {
        perror("Error opening output file");
        return 1;
    }

    printf("Output file opened successfully.\n");

    /*
     * Save original stdout.
     */
    original_stdout = dup(STDOUT_FILENO);

    if (original_stdout == -1)
    {
        perror("dup stdout");
        close(output_file);
        return 1;
    }

    /*
     * Save original stderr.
     */
    original_stderr = dup(STDERR_FILENO);

    if (original_stderr == -1)
    {
        perror("dup stderr");
        close(output_file);
        close(original_stdout);
        return 1;
    }

    /*
     * Redirect stdout to the output file.
     */
    if (dup2(output_file, STDOUT_FILENO) == -1)
    {
        perror("dup2 stdout");
        return 1;
    }

    /*
     * 2>&1
     *
     * Make stderr point to the same file
     * as stdout.
     */
    if (dup2(STDOUT_FILENO, STDERR_FILENO) == -1)
    {
        perror("dup2 stderr");
        return 1;
    }

    /*
     * The original output file descriptor
     * is no longer required.
     */
    close(output_file);

    /*
     * Create child process.
     */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /*
     * Child process.
     */
    if (pid == 0)
    {
        /*
         * Execute command with two arguments.
         *
         * Example:
         * ls existing.txt missing.txt
         */
        execlp(command,
               command,
               arg1,
               arg2,
               NULL);

        /*
         * If execution fails,
         * this error also goes to combined.txt.
         */
        perror("Command execution failed");
        exit(1);
    }

    /*
     * Parent waits for child.
     */
    waitpid(pid, &status, 0);

    /*
     * Restore stdout.
     */
    if (dup2(original_stdout, STDOUT_FILENO) == -1)
    {
        perror("Restoring stdout");
        return 1;
    }

    /*
     * Restore stderr.
     */
    if (dup2(original_stderr, STDERR_FILENO) == -1)
    {
        perror("Restoring stderr");
        return 1;
    }

    close(original_stdout);
    close(original_stderr);

    printf("\nStandard output restored successfully.\n");
    printf("Standard error restored successfully.\n");

    if (WIFEXITED(status))
    {
        printf("Child process exited with status: %d\n",
               WEXITSTATUS(status));
    }

    printf("Combined output saved in: %s\n", filename);

    return 0;
}
