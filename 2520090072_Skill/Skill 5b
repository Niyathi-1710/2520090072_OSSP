#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    char name[] = "Niyathi";
    char result[200];

    // 1. Apply double quotes
    printf("1. Double Quotes:\n");
    printf("\"Hello World\"\n");

    // 2. Preserve spaces
    printf("\n2. Preserve Spaces:\n");
    printf("%s\n", "Hello    World");

    // 3. Allow variable expansion
    printf("\n3. Variable Expansion:\n");
    snprintf(result, sizeof(result),
             "Hello %s", name);
    printf("%s\n", result);

    // 4. Parse nested tokens
    printf("\n4. Parse Nested Tokens:\n");

    char command[] = "echo \"Hello World\"";
    char *token = strtok(command, " ");

    while (token != NULL) {
        printf("Token: %s\n", token);
        token = strtok(NULL, " ");
    }

    // 5. Validate outputs
    printf("\n5. Validate Outputs:\n");

    if (strcmp(result, "Hello Niyathi") == 0)
        printf("Validation Successful\n");
    else
        printf("Validation Failed\n");

    // 6. Test quoted commands
    printf("\n6. Test Quoted Commands:\n");

    system("echo \"Hello    World\"");
    system("echo \"Welcome to Linux\"");

    return 0;
}
