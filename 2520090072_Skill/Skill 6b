#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string.h>

#define MAX_ARGS 20

int main()
{
    char input[200];
    char *args[MAX_ARGS];
    int argc = 0;

    pid_t pid;
    int status;

    printf("=============================================\n");
    printf("       CHILD PROCESS & EXECUTION\n");
    printf("=============================================\n");

    printf("\nEnter a command with arguments:\n");
    printf("Example: ls -l\n");
    printf("Example: echo Hello World\n");
    printf("Example: pwd\n\n");

    printf("> ");

    if (fgets(input, sizeof(input), stdin) == NULL)
    {
        printf("Error reading input.\n");
        return 1;
    }

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /* Split input into arguments */
    char *token = strtok(input, " ");

    while (token != NULL && argc < MAX_ARGS - 1)
    {
        args[argc++] = token;
        token = strtok(NULL, " ");
    }

    /* NULL marks the end of arguments */
    args[argc] = NULL;

    if (argc == 0)
    {
        printf("No command entered.\n");
        return 1;
    }

    printf("\nParent Process:\n");
    printf("PID = %d\n", getpid());

    /* Create child process */
    pid = fork();

    if (pid < 0)
    {
        /* fork() failed */
        perror("fork failed");
        return 1;
    }

    else if (pid == 0)
    {
        /* Child process */
        printf("\nChild Process:\n");
        printf("PID = %d\n", getpid());
        printf("Parent PID = %d\n", getppid());

        printf("Executing command: %s\n\n", args[0]);

        /*
         * Execute the requested program.
         * execvp() searches for the program
         * in the PATH environment variable.
         */
        execvp(args[0], args);

        /*
         * This line executes only if execvp()
         * fails.
         */
        perror("execvp failed");

        printf("Child process could not execute the command.\n");

        exit(1);
    }

    else
    {
        /* Parent process */
        printf("\nParent: Created child with PID = %d\n",
               pid);

        printf("Parent: Waiting for child to finish...\n");

        /*
         * Wait for child process.
         */
        if (waitpid(pid, &status, 0) == -1)
        {
            perror("waitpid failed");
            return 1;
        }

        printf("\nParent: Child process finished.\n");

        /* Check how child terminated */
        if (WIFEXITED(status))
        {
            printf("Child exit status: %d\n",
                   WEXITSTATUS(status));
        }
        else if (WIFSIGNALED(status))
        {
            printf("Child terminated by signal: %d\n",
                   WTERMSIG(status));
        }
    }

    printf("\nParent process completed.\n");

    return 0;
}
