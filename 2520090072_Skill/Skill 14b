#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_INPUT 200

int main()
{
    char input[MAX_INPUT];
    char command[100];
    char argument[100];
    char filename[100];

    int error_file;
    int original_stderr;
    pid_t pid;
    int status;

    printf("Enter command with stderr redirection: ");

    fgets(input, sizeof(input), stdin);

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /*
     * Parse:
     * command argument 2> filename
     *
     * Example:
     * ls nonexistent.txt 2> error.txt
     */
    if (sscanf(input, "%s %s 2> %s",
               command, argument, filename) != 3)
    {
        printf("Invalid input format.\n");
        printf("Use: command argument 2> filename\n");
        return 1;
    }

    printf("Command: %s\n", command);
    printf("Argument: %s\n", argument);
    printf("Error file: %s\n", filename);

    /*
     * Open the error output file.
     *
     * O_WRONLY -> write only
     * O_CREAT  -> create if it doesn't exist
     * O_TRUNC  -> remove old contents
     */
    error_file = open(filename,
                      O_WRONLY | O_CREAT | O_TRUNC,
                      0644);

    if (error_file == -1)
    {
        perror("Error opening error file");
        printf("Could not create the error output file.\n");
        return 1;
    }

    printf("Error output file opened successfully.\n");

    /*
     * Save original stderr.
     */
    original_stderr = dup(STDERR_FILENO);

    if (original_stderr == -1)
    {
        perror("dup");
        close(error_file);
        return 1;
    }

    /*
     * Redirect stderr to the error file.
     */
    if (dup2(error_file, STDERR_FILENO) == -1)
    {
        perror("dup2");
        close(error_file);
        close(original_stderr);
        return 1;
    }

    /* Close original file descriptor */
    close(error_file);

    /*
     * Create child process.
     */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /*
     * Child process.
     */
    if (pid == 0)
    {
        /*
         * Execute command.
         *
         * If the command produces an error,
         * the error goes into the file.
         */
        execlp(command, command, argument, NULL);

        /*
         * If execlp fails, this error also
         * goes to the redirected stderr.
         */
        perror("Command execution failed");
        exit(1);
    }

    /*
     * Parent waits for child.
     */
    waitpid(pid, &status, 0);

    /*
     * Restore original stderr.
     */
    if (dup2(original_stderr, STDERR_FILENO) == -1)
    {
        perror("Restoring stderr");
        close(original_stderr);
        return 1;
    }

    close(original_stderr);

    /*
     * Check child status.
     */
    if (WIFEXITED(status))
    {
        printf("\nChild process exited with status: %d\n",
               WEXITSTATUS(status));
    }

    printf("Standard error restored successfully.\n");
    printf("Error output saved in: %s\n", filename);

    return 0;
}
