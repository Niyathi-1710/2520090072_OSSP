#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_INPUT 200

int main()
{
    char input[MAX_INPUT];
    char command[100];
    char filename[100];

    int output_file;
    int original_stdout;
    pid_t pid;

    printf("Enter command with output redirection: ");
    fgets(input, sizeof(input), stdin);

    /* Remove newline */
    input[strcspn(input, "\n")] = '\0';

    /*
     * Parse command.
     * Example:
     * ls -l > output.txt
     *
     * This simple version expects:
     * command > filename
     */
    if (sscanf(input, "%s > %s", command, filename) != 2)
    {
        printf("Invalid input format.\n");
        printf("Use: command > filename\n");
        return 1;
    }

    printf("Command: %s\n", command);
    printf("Output file: %s\n", filename);

    /*
     * Create the output file.
     *
     * O_WRONLY  -> open for writing
     * O_CREAT   -> create if it doesn't exist
     * O_TRUNC   -> remove old contents
     */
    output_file = open(filename,
                       O_WRONLY | O_CREAT | O_TRUNC,
                       0644);

    if (output_file == -1)
    {
        perror("Error opening output file");
        printf("Check the file permissions or directory.\n");
        return 1;
    }

    printf("Output file opened successfully.\n");

    /*
     * Save original stdout.
     */
    original_stdout = dup(STDOUT_FILENO);

    if (original_stdout == -1)
    {
        perror("dup");
        close(output_file);
        return 1;
    }

    /*
     * Redirect stdout to the output file.
     */
    if (dup2(output_file, STDOUT_FILENO) == -1)
    {
        perror("dup2");
        close(output_file);
        close(original_stdout);
        return 1;
    }

    /*
     * Original descriptor is no longer needed.
     */
    close(output_file);

    /*
     * Create child process.
     */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /*
     * Child process.
     */
    if (pid == 0)
    {
        /*
         * Execute command.
         * Its output goes into the file.
         */
        execlp(command, command, NULL);

        /*
         * If execlp fails.
         */
        perror("execlp");
        exit(1);
    }

    /*
     * Parent waits for child.
     */
    wait(NULL);

    /*
     * Restore original stdout.
     */
    if (dup2(original_stdout, STDOUT_FILENO) == -1)
    {
        perror("Restoring stdout");
        close(original_stdout);
        return 1;
    }

    close(original_stdout);

    printf("\nStandard output restored successfully.\n");
    printf("Output has been redirected to: %s\n", filename);
    printf("Program completed successfully.\n");

    return 0;
}
