#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int pipefd[2];
    pid_t pid;

    /* Create pipe */
    if (pipe(pipefd) == -1)
    {
        perror("pipe");
        return 1;
    }

    printf("Pipe created successfully.\n");

    /* Create child process */
    pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    /* Child process */
    if (pid == 0)
    {
        printf("Child: Executing first command...\n");

        /* Close unused read end */
        close(pipefd[0]);

        /* Redirect standard output to pipe */
        dup2(pipefd[1], STDOUT_FILENO);

        /* Close original pipe descriptor */
        close(pipefd[1]);

        /* Execute first command */
        execlp("ls", "ls", "-1", NULL);

        /* If execlp fails */
        perror("execlp");
        exit(1);
    }

    /* Parent process */
    else
    {
        int status;

        printf("Parent: Waiting for child process...\n");

        /* Close unused write end */
        close(pipefd[1]);

        /* Wait for child to finish */
        waitpid(pid, &status, 0);

        if (WIFEXITED(status))
        {
            printf("Parent: Child process completed.\n");
        }

        printf("Parent: Executing second command...\n");

        /* Redirect standard input from pipe */
        dup2(pipefd[0], STDIN_FILENO);

        /* Close original pipe descriptor */
        close(pipefd[0]);

        /*
         * Execute second command.
         * wc -l reads the output of ls from the pipe.
         */
        execlp("wc", "wc", "-l", NULL);

        /* If execlp fails */
        perror("execlp");
        exit(1);
    }

    return 0;
}
