#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/wait.h>

#define MAX_COMMANDS 10
#define MAX_ARGUMENTS 20
#define MAX_INPUT 500

typedef struct
{
    char *arguments[MAX_ARGUMENTS];
    int argument_count;

    char *input_file;
    char *output_file;
    char *error_file;

    int append_output;
    int redirect_error;
    int merge_error;

} Command;


/* Remove leading and trailing spaces */
char *trim(char *text)
{
    while (*text == ' ')
        text++;

    char *end = text + strlen(text) - 1;

    while (end > text && *end == ' ')
    {
        *end = '\0';
        end--;
    }

    return text;
}


/* Initialize command structure */
void initialize_command(Command *cmd)
{
    int i;

    cmd->argument_count = 0;
    cmd->input_file = NULL;
    cmd->output_file = NULL;
    cmd->error_file = NULL;

    cmd->append_output = 0;
    cmd->redirect_error = 0;
    cmd->merge_error = 0;

    for (i = 0; i < MAX_ARGUMENTS; i++)
    {
        cmd->arguments[i] = NULL;
    }
}


/*
 * Parse one individual command.
 *
 * Example:
 *
 * grep hello < input.txt > output.txt
 */
int parse_command(char *text, Command *cmd)
{
    char *token;

    initialize_command(cmd);

    token = strtok(text, " ");

    while (token != NULL)
    {
        /* Input redirection */
        if (strcmp(token, "<") == 0)
        {
            token = strtok(NULL, " ");

            if (token == NULL)
            {
                printf("Syntax Error: Missing input file.\n");
                return 0;
            }

            cmd->input_file = token;
        }

        /* Output redirection */
        else if (strcmp(token, ">") == 0)
        {
            token = strtok(NULL, " ");

            if (token == NULL)
            {
                printf("Syntax Error: Missing output file.\n");
                return 0;
            }

            cmd->output_file = token;
            cmd->append_output = 0;
        }

        /* Append redirection */
        else if (strcmp(token, ">>") == 0)
        {
            token = strtok(NULL, " ");

            if (token == NULL)
            {
                printf("Syntax Error: Missing output file.\n");
                return 0;
            }

            cmd->output_file = token;
            cmd->append_output = 1;
        }

        /* Error redirection */
        else if (strcmp(token, "2>") == 0)
        {
            token = strtok(NULL, " ");

            if (token == NULL)
            {
                printf("Syntax Error: Missing error file.\n");
                return 0;
            }

            cmd->error_file = token;
            cmd->redirect_error = 1;
        }

        /* Combined stderr and stdout */
        else if (strcmp(token, "2>&1") == 0)
        {
            cmd->merge_error = 1;
        }

        /* Normal command argument */
        else
        {
            if (cmd->argument_count >= MAX_ARGUMENTS - 1)
            {
                printf("Too many arguments.\n");
                return 0;
            }

            cmd->arguments[cmd->argument_count] = token;
            cmd->argument_count++;
        }

        token = strtok(NULL, " ");
    }

    cmd->arguments[cmd->argument_count] = NULL;

    if (cmd->argument_count == 0)
    {
        printf("Syntax Error: Empty command.\n");
        return 0;
    }

    return 1;
}


/* Display execution plan */
void display_execution_plan(Command commands[], int count)
{
    int i;
    int j;

    printf("\n========== EXECUTION PLAN ==========\n");

    for (i = 0; i < count; i++)
    {
        printf("\nCommand %d: ", i + 1);

        for (j = 0; j < commands[i].argument_count; j++)
        {
            printf("%s ", commands[i].arguments[j]);
        }

        printf("\n");

        if (commands[i].input_file != NULL)
        {
            printf("Input  : %s\n",
                   commands[i].input_file);
        }

        if (commands[i].output_file != NULL)
        {
            if (commands[i].append_output)
                printf("Output : %s (append)\n",
                       commands[i].output_file);
            else
                printf("Output : %s\n",
                       commands[i].output_file);
        }

        if (commands[i].error_file != NULL)
        {
            printf("Error  : %s\n",
                   commands[i].error_file);
        }

        if (commands[i].merge_error)
        {
            printf("Error  : merged with stdout\n");
        }

        if (i < count - 1)
        {
            printf("        |\n");
            printf("        v\n");
            printf("      PIPE\n");
        }
    }

    printf("\n====================================\n");
}


/* Execute the complete pipeline */
void execute_commands(Command commands[], int count)
{
    int pipes[MAX_COMMANDS - 1][2];

    pid_t pids[MAX_COMMANDS];

    int i;
    int j;

    /*
     * Create required pipes.
     */
    for (i = 0; i < count - 1; i++)
    {
        if (pipe(pipes[i]) == -1)
        {
            perror("pipe");
            return;
        }
    }

    /*
     * Create one process for each command.
     */
    for (i = 0; i < count; i++)
    {
        pids[i] = fork();

        if (pids[i] < 0)
        {
            perror("fork");
            return;
        }

        /* Child process */
        if (pids[i] == 0)
        {
            int fd;

            /*
             * Connect input from previous pipe.
             */
            if (i > 0)
            {
                if (dup2(pipes[i - 1][0],
                         STDIN_FILENO) == -1)
                {
                    perror("dup2 input pipe");
                    exit(1);
                }
            }

            /*
             * Connect output to next pipe.
             */
            if (i < count - 1)
            {
                if (dup2(pipes[i][1],
                         STDOUT_FILENO) == -1)
                {
                    perror("dup2 output pipe");
                    exit(1);
                }
            }

            /*
             * Input redirection.
             *
             * This overrides the pipe input if present.
             */
            if (commands[i].input_file != NULL)
            {
                fd = open(commands[i].input_file,
                          O_RDONLY);

                if (fd == -1)
                {
                    perror("Input file");
                    exit(1);
                }

                dup2(fd, STDIN_FILENO);
                close(fd);
            }

            /*
             * Output redirection.
             *
             * This overrides the pipe output if present.
             */
            if (commands[i].output_file != NULL)
            {
                if (commands[i].append_output)
                {
                    fd = open(commands[i].output_file,
                              O_WRONLY |
                              O_CREAT |
                              O_APPEND,
                              0644);
                }
                else
                {
                    fd = open(commands[i].output_file,
                              O_WRONLY |
                              O_CREAT |
                              O_TRUNC,
                              0644);
                }

                if (fd == -1)
                {
                    perror("Output file");
                    exit(1);
                }

                dup2(fd, STDOUT_FILENO);
                close(fd);
            }

            /*
             * Error redirection.
             */
            if (commands[i].redirect_error)
            {
                fd = open(commands[i].error_file,
                          O_WRONLY |
                          O_CREAT |
                          O_TRUNC,
                          0644);

                if (fd == -1)
                {
                    perror("Error file");
                    exit(1);
                }

                dup2(fd, STDERR_FILENO);
                close(fd);
            }

            /*
             * Merge stderr with stdout.
             */
            if (commands[i].merge_error)
            {
                dup2(STDOUT_FILENO,
                     STDERR_FILENO);
            }

            /*
             * Close all pipe descriptors.
             */
            for (j = 0; j < count - 1; j++)
            {
                close(pipes[j][0]);
                close(pipes[j][1]);
            }

            /*
             * Execute command.
             */
            execvp(commands[i].arguments[0],
                   commands[i].arguments);

            /*
             * If execution fails.
             */
            perror("Command execution failed");
            exit(1);
        }
    }

    /*
     * Parent closes all pipe descriptors.
     */
    for (i = 0; i < count - 1; i++)
    {
        close(pipes[i][0]);
        close(pipes[i][1]);
    }

    /*
     * Wait for all children.
     */
    for (i = 0; i < count; i++)
    {
        waitpid(pids[i], NULL, 0);
    }
}


int main()
{
    char input[MAX_INPUT];

    char *pipeline_parts[MAX_COMMANDS];

    Command commands[MAX_COMMANDS];

    int command_count = 0;

    int i;

    printf("========================================\n");
    printf("      COMPLEX COMMAND INTERPRETER       \n");
    printf("========================================\n");

    printf("\nSupported operators:\n");
    printf("  |       Pipe\n");
    printf("  <       Input redirection\n");
    printf("  >       Output redirection\n");
    printf("  >>      Append output\n");
    printf("  2>      Error redirection\n");
    printf("  2>&1    Merge stderr with stdout\n");

    printf("\nEnter command:\n");
    printf("> ");

    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    /*
     * Check for empty input.
     */
    if (strlen(input) == 0)
    {
        printf("Error: Empty command.\n");
        return 1;
    }

    /*
     * Split input using pipe symbol.
     */
    pipeline_parts[command_count] =
        strtok(input, "|");

    while (pipeline_parts[command_count] != NULL)
    {
        pipeline_parts[command_count] =
            trim(pipeline_parts[command_count]);

        command_count++;

        if (command_count >= MAX_COMMANDS)
        {
            printf("Too many commands in pipeline.\n");
            return 1;
        }

        pipeline_parts[command_count] =
            strtok(NULL, "|");
    }

    /*
     * Check for invalid pipe placement.
     */
    for (i = 0; i < command_count; i++)
    {
        if (strlen(pipeline_parts[i]) == 0)
        {
            printf("Syntax Error: Invalid pipe placement.\n");
            return 1;
        }
    }

    /*
     * Parse every command.
     */
    for (i = 0; i < command_count; i++)
    {
        if (!parse_command(pipeline_parts[i],
                           &commands[i]))
        {
            printf("Command parsing failed.\n");
            return 1;
        }
    }

    /*
     * Display execution plan.
     */
    display_execution_plan(commands,
                           command_count);

    /*
     * Execute commands.
     */
    printf("\nExecuting commands...\n\n");

    execute_commands(commands,
                     command_count);

    printf("\nExecution completed.\n");

    return 0;
}
