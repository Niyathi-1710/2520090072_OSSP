#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX 50

typedef struct Node {
    char value[50];
    struct Node *left;
    struct Node *right;
} Node;

/* Create a parse-tree node */
Node* createNode(char *value) {
    Node *node = malloc(sizeof(Node));
    strcpy(node->value, value);
    node->left = node->right = NULL;
    return node;
}

/* Display parse tree */
void display(Node *root, int level) {
    if (root == NULL)
        return;

    for (int i = 0; i < level; i++)
        printf("  ");

    printf("|-- %s\n", root->value);

    display(root->left, level + 1);
    display(root->right, level + 1);
}

/* Free parse tree */
void freeTree(Node *root) {
    if (root == NULL)
        return;

    freeTree(root->left);
    freeTree(root->right);
    free(root);
}

int main() {
    char input[200];
    char *tokens[MAX];
    int count = 0;

    printf("Enter command: ");
    fgets(input, sizeof(input), stdin);

    /* Handle empty command */
    if (input[0] == '\n') {
        printf("Error: Empty command!\n");
        return 0;
    }

    /* Tokenize */
    char *p = strtok(input, " \t\n");

    while (p != NULL && count < MAX) {
        tokens[count++] = p;
        p = strtok(NULL, " \t\n");
    }

    if (count == 0) {
        printf("Error: No command found!\n");
        return 0;
    }

    /* Basic syntax validation */
    for (int i = 0; i < count; i++) {
        if (strcmp(tokens[i], "|") == 0 &&
            (i == 0 || i == count - 1)) {
            printf("Syntax Error: Invalid pipe position!\n");
            return 0;
        }
    }

    /* Create execution structure */
    Node *root = createNode(tokens[0]);
    Node *current = root;

    for (int i = 1; i < count; i++) {
        if (strcmp(tokens[i], "|") == 0)
            current->right = createNode("|");
        else
            current->left = createNode(tokens[i]);

        current = (strcmp(tokens[i], "|") == 0)
                 ? current->right : current;
    }

    printf("\nSyntax Valid!\n");

    printf("\nParse / Execution Tree:\n");
    display(root, 0);

    freeTree(root);

    return 0;
}
